POSTGRES_USER=mami_user
POSTGRES_PASSWORD=CHANGE_ME_strong_db_password

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=CHANGE_ME_64_char_hex_secret

ADMIN_EMAIL=admin@yourdomain.com
ADMIN_PASSWORD=CHANGE_ME_strong_admin_password

# Optional — extra admin accounts beyond ADMIN_EMAIL, for environments that need
# more than one (e.g. production). Format: "email:password,email:password".
# Leave empty/unset on environments that should only have the single primary admin.
# ADDITIONAL_ADMINS=second-admin@yourdomain.com:CHANGE_ME_strong_password

# Production only (docker-compose.prod.yml) — your domain or public IP
# Examples: checker.coe-dsc.nl   or   178.33.120.5
DOMAIN=your-domain-or-ip-here
